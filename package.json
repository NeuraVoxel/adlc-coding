{
  "name": "adlc-coding",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.tools.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ci": "tsx scripts/run-gates.ts ci-primary",
    "doc-sync": "tsx scripts/run-gates.ts doc-sync",
    "check:all": "tsx scripts/run-gates.ts check-all",
    "create": "tsx packages/create-adlc-coding/bin.ts",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "lefthook": "^2.1.9",
    "oxlint": "1.76.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
